library(dplyr)
library(ggplot2)
library(nycflights13)
airlines <- airlines
airports <- airports
flights <- flights
planes <- planes
weather <- weather
Top10Flights <- sort(table(flights$dest), decreasing = TRUE)
Top10Flights <- head(Top10Flights, 10)
Top10Flights
flights$dep_time_category <- ifelse(is.na(flights$dep_time), NA, ifelse(flights$dep_time < 600, "Early Morning", ifelse(flights$dep_time < 1200, "Morning", ifelse(flights$dep_time < 1800, "Afternoon", "Evening"))))
flights$arr_time_category <- ifelse(is.na(flights$arr_time), NA, ifelse(flights$arr_time < 600, "Early Morning", ifelse(flights$arr_time < 1200, "Morning", ifelse(flights$arr_time < 1800, "Afternoon", "Evening"))))
Time_Labels <- c("Early Morning", "Morning", "Afternoon", "Evening")
barplot(table(flights$dep_time_category), main = "Flights by Departure Time Category", xlab = "Departure Time", ylab = "Number of Flights", ylim = c(0, 160000))
barplot(table(flights$arr_time_category), main = "Flights by Arrival Time Category", xlab = "Arrival Time", ylab = "Number of Flights", ylim = c(0, 160000))
# Percentage of Flights that were Red Eye Flights (Depart: Afternoon and Evening, Arrive: Early Morning and Morning)
flights <- flights[!is.na(flights$dep_time) & !is.na(flights$arr_time),]
flights$red_eye <- flights$dep_time_category %in% c("Afternoon", "Evening") & flights$arr_time_category %in% c("Early Morning", "Morning")
RedEyePercentage <- mean(flights$red_eye, na.rm = TRUE) * 100
RedEyePercentage
RedEyeNumber <- table(flights$red_eye)
RedEyePercentage2 <- data.frame(Red_Eye = names(RedEyeNumber), Amount = as.vector(RedEyeNumber), Percentage = as.vector(prop.table(RedEyeNumber)*100))
RedEyePercentage2
Plane_Airlines_Carriers <- unique(flights[c("tailnum", "carrier")])
Carriers_by_Tailnum <- split(Plane_Airlines_Carriers$carrier, Plane_Airlines_Carriers$tailnum)
Carriers_by_Tailnum <- Carriers_by_Tailnum[sapply(Carriers_by_Tailnum, length) >1]
as.data.frame(Carriers_by_Tailnum)
weather
airports
weather$Unique_Weather <- paste(weather$year, weather$month, weather$day, weather$hour, weather$origin)
sum(duplicated(weather$Unique_Weather))
weather[duplicated(weather$Unique_Weather, fromLast = TRUE), c("time_hour", "Unique_Weather")]
Merged_Flights_Weather <- merge(flights, weather, by = c("time_hour", "origin"), all.x = TRUE)
Merged_Flights_Weather <- subset(Merged_Flights_Weather, select = - c(year.y, month.y, day.y, hour.y))
names(Merged_Flights_Weather)[names(Merged_Flights_Weather) == "year.x"] <- "year"
names(Merged_Flights_Weather)[names(Merged_Flights_Weather) == "month.x"] <- "month"
names(Merged_Flights_Weather)[names(Merged_Flights_Weather) == "day.x"] <- "day"
names(Merged_Flights_Weather)[names(Merged_Flights_Weather) == "hour.x"] <- "hour"
# 2. Check the size of the data
dim(Merged_Flights_Weather)
nrow(Merged_Flights_Weather)
ncol(Merged_Flights_Weather)
# 3. Examine the variables and their types
str(Merged_Flights_Weather)
# 4. Look at the top and bottom of the data
head(Merged_Flights_Weather)
tail(Merged_Flights_Weather)
# 5. Visualize the distributions of key variables
barplot(table(Merged_Flights_Weather$origin), main = "Number of Flights by Origin Airport", xlab = "Origin Airport", ylab = "Number of Flights", ylim = c(0, 140000))
mean(is.na(Merged_Flights_Weather$origin))
hist(Merged_Flights_Weather$dep_delay, main = "Distribution of Departure Delays", xlab = "Departure Delay (minutes)", sub = "Negative Values Represent Earlier Depature")
summary(Merged_Flights_Weather$dep_delay)
mean(is.na(Merged_Flights_Weather$dep_delay))
hist(Merged_Flights_Weather$arr_delay, main = "Distribution of Arrival Delays", xlab = "Arrival Delay (minutes)", sub = "Negative Values Represent Earlier Arrival")
summary(Merged_Flights_Weather$arr_delay)
mean(is.na(Merged_Flights_Weather$arr_delay))
hist(Merged_Flights_Weather$temp, main = "Distribution of Temperatures at Origin Airports", xlab = "Temperature (Fahrenheit)")
summary(Merged_Flights_Weather$temp)
mean(is.na(Merged_Flights_Weather$temp))
hist(Merged_Flights_Weather$dewp, main = "Distribution of Dewpoint at Origin Airports", xlab = "Dew Point (Fahrenheit)")
summary(Merged_Flights_Weather$dewp)
mean(is.na(Merged_Flights_Weather$dewp))
hist(Merged_Flights_Weather$humid, main = "Distribution of Humidity at Origin Airports", xlab =
"Humidity")
summary(Merged_Flights_Weather$humid)
mean(is.na(Merged_Flights_Weather$humid))
hist(Merged_Flights_Weather$wind_speed, main = "Distribution of Wind Speed at Origin Airports", xlab = "Wind Speed (mph)")
summary(Merged_Flights_Weather$wind_speed)
mean(is.na(Merged_Flights_Weather$wind_speed))
hist(Merged_Flights_Weather$wind_gust, main = "Distribution of Wind Gust at Origin Airports", xlab = "Wind Gust (mph)")
summary(Merged_Flights_Weather$wind_gust)
mean(is.na(Merged_Flights_Weather$wind_gust))
hist(Merged_Flights_Weather$precip, main = "Distribution of Precipitation at Origin Airports", xlab = "Precipitation (inches)")
summary(Merged_Flights_Weather$precip)
mean(is.na(Merged_Flights_Weather$precip))
hist(Merged_Flights_Weather$pressure, main = "Distribution of Atmospheric Pressure at Origin Airports", xlab = "Atmospheric Pressure (millibars)")
summary(Merged_Flights_Weather$pressure)
mean(is.na(Merged_Flights_Weather$pressure))
hist(Merged_Flights_Weather$visib, main = "Distribution of Visibility at Origin Airports", xlab = "Visibility (miles)")
summary(Merged_Flights_Weather$visib)
mean(is.na(Merged_Flights_Weather$visib))
Daily_Delay <- Merged_Flights_Weather |>
group_by(year, month, day) |>
summarize(Average_Departure_Delay = mean(dep_delay, na.rm = TRUE), Amount_of_Flights = n()) |>
arrange(desc(Average_Departure_Delay))
head(Daily_Delay)
Daily_Delay_Airport <- Merged_Flights_Weather |>
group_by(year, month, day, origin) |>
summarize (Average_Depatrue_Delay = mean(dep_delay, na.rm = TRUE), Amount_of_Flights = n()) |>
arrange(desc(Average_Depatrue_Delay))
head(Daily_Delay_Airport)
Hourly_Delay_Airport <- Merged_Flights_Weather |>
group_by(time_hour, origin) |>
summarize(Average_Depature_Delay = mean(dep_delay, na.rm = TRUE), Amount_of_Flights = n()) |>
arrange(desc(Average_Depature_Delay))
head(Hourly_Delay_Airport)
Arrival_Delay <- Merged_Flights_Weather |>
group_by(dest) |>
summarize(Average_Arrival_Delay = mean(arr_delay, na.rm = TRUE), Amount_of_Flights = sum(!is.na(arr_delay))) |>
filter(Amount_of_Flights > 0)
airports <- airports |>
left_join(Arrival_Delay, by = c("faa" = "dest"))
airports <- airports |>
filter(!is.na(Average_Arrival_Delay))
US_Map <- map_data("state")
ggplot() +
geom_polygon(data = US_Map, aes(x = long, y = lat, group = group), fill = "gray", color = "white") +
geom_point(data=airports,  aes(x = lon, y = lat, color = Average_Arrival_Delay)) +
scale_color_gradient2(low = "darkblue", mid = "orange", high = "cyan", name = "Average Arrival Delay (Minutes)") +
labs(title = "Average Arrival Delay by Arrival Airport", x = "Longitude", y = "Latitude")
Weather_Variables <- c("dep_delay", "temp", "humid", "dewp", "wind_speed", "wind_gust", "precip", "pressure", "visib")
Weather_Delay <- Merged_Flights_Weather
Weather_Delay$Visibility_Category <- ifelse(is.na(Weather_Delay$visib), NA, ifelse(Weather_Delay$visib < 3, "Low Visibility", "High Visibility"))
Weather_Delay$Precipitation_Category <- ifelse(is.na(Weather_Delay$precip), NA, ifelse(Weather_Delay$precip > 0, "Precipitation", "No Precipitation"))
Weather_Delay$WindSpeed_Category <- ifelse(is.na(Weather_Delay$wind_speed), NA, ifelse(Weather_Delay$wind_speed >= 30, "High Wind", "Low Wind"))
Weather_Delay$WindGust_Category <- ifelse(is.na(Weather_Delay$wind_gust), NA, ifelse(Weather_Delay$wind_gust >= 30, "High Gust", "Low Gust"))
Weather_Delay$Pressure_Category <- ifelse(is.na(Weather_Delay$pressure), NA, ifelse(Weather_Delay$pressure >= 1015.92, "High Pressure", "Low Pressure"))
Weather_Delay$Dewpoint_Category <- ifelse(is.na(Weather_Delay$dewp), NA, ifelse(Weather_Delay$dewp >= 65, "High Dew Point", "Low Dew Point"))
Weather_Delay$Temperature_Category <- ifelse(is.na(Weather_Delay$temp), NA, ifelse(Weather_Delay$temp >= 32, "Not Freezing", "Freezing"))
Weather_Delay$Humidity_Category <- ifelse(is.na(Weather_Delay$humid), NA, ifelse(Weather_Delay$humid >= 70, "High Humidity", "Low Humidity"))
Correlations <- cor(Weather_Delay[Weather_Variables], use = "pairwise.complete.obs", method = "spearman")
Departure_Delay_Correlation <- Correlations[rownames(Correlations) != "dep_delay", "dep_delay"]
Departure_Delay_Correlation <- Departure_Delay_Correlation[order(Departure_Delay_Correlation, decreasing = TRUE)]
Departure_Delay_Correlation
barplot(Departure_Delay_Correlation, horiz = TRUE, las = 1, col = ifelse(Departure_Delay_Correlation >0, "red", "blue"), xlab = "Correlation with Departure Delay", main = "Weather and Departure Delays")
Visibility_Delay <- Weather_Delay |>
filter(!is.na(Visibility_Category),!is.na(dep_delay)) |>
group_by(origin, Visibility_Category) |>
summarize(Departure_Delay_Mean = mean(dep_delay), Number_of_Flights = n(),.groups = "drop")
ggplot(Visibility_Delay,aes(x = origin, y = Departure_Delay_Mean,fill = Visibility_Category)) +
geom_col(position = "dodge") +
scale_fill_manual(values = c("High Visibility" = "red", "Low Visibility" = "blue")) +
labs(title = "Average Departure Delay by Visibility", x = "Departure Airport", y = "Average Departure Delay (minutes)", subtitle = "A higher average for Low Visibility indicates a longer departure delay", fill = "Visibility Category")
Delayed <- !is.na(Weather_Delay$dep_delay) & Weather_Delay$dep_delay > 0
Amount_Delayed <- sum(Delayed)
plot(Weather_Delay$visib, Weather_Delay$dep_delay, xlab = "Visibility (miles)", ylab = "Departure Delay (minutes)", main = "Departure Delay by Visbility", xlim = c(0,10))
Visibility_Bins <- cut(
Weather_Delay$visib[Delayed],
breaks = c(0, 3, Inf),
right = FALSE
)
Delayed_Counts <- table(Visibility_Bins)
barplot(
Delayed_Counts,
xlab = "Wind Speed (mph)",
ylab = "Number of Delayed Flights",
main = "Number of Delayed Flights by Wind Speed"
)
Precipitation_Delay <- Weather_Delay |>
filter(!is.na(Precipitation_Category),!is.na(dep_delay)) |>
group_by(origin, Precipitation_Category) |>
summarize(Departure_Delay_Mean = mean(dep_delay), Number_of_Flights = n(),.groups = "drop")
ggplot(Precipitation_Delay,aes(x = origin, y = Departure_Delay_Mean,fill = Precipitation_Category)) +
geom_col(position = "dodge") +
scale_fill_manual(values = c( "No Precipitation" = "blue", "Precipitation" = "red")) +
labs(title = "Average Departure Delay by Precipitation", x = "Departure Airport", y = "Average Departure Delay (minutes)", subtitle = "A higher average for Precipitation indicates a longer departure delay", fill = "Precipitation Category")
plot(Weather_Delay$precip, Weather_Delay$dep_delay, xlab = "Precipitaton (inches)", ylab = "Departure Delay (minutes)", main = "Departure Delay by Precipitation")
ggplot(
Weather_Delay,
aes(x = precip, y = dep_delay)
) +
geom_point(
alpha = 0.05,
size = 0.8
) +
geom_smooth(
method = "loess",
se = FALSE,
color = "red"
) +
coord_cartesian(
xlim = c(0, 0.6),
ylim = c(-50, 300)
) +
labs(
title = "Departure Delay by Precipitation",
x = "Precipitation (inches)",
y = "Departure Delay (minutes)"
) +
theme_minimal()
